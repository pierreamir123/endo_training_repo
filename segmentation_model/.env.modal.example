# Copy to  segmentation_model/.env.modal  and fill in. Load before `modal run`:
#   set -a; . segmentation_model/.env.modal; set +a      # bash
#   Get-Content segmentation_model/.env.modal | ForEach-Object { if ($_ -match '^(\w+)=(.*)') { [Environment]::SetEnvironmentVariable($matches[1],$matches[2]) } }   # PowerShell

# Google Drive file id of the dataset zip (from .../d/<ID>/view). Used by fetch_data.
GDRIVE_ID=

# Modal GPU type: T4 (default, 16GB), A10G, L4, A100-40GB, ...
MODAL_GPU=T4

# Only if training with --wandb online (also needs the modal secret; see modal_train.py header).
WANDB_API_KEY=
WANDB_PROJECT=prad-segmentation-model
WANDB_ENTITY=pierrebassily

# Modal auth is NOT set here — run `modal token new` once; it writes ~/.modal.toml.
